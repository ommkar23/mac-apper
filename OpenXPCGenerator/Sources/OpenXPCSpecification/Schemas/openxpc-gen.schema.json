{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openxpc.local/schemas/openxpc-gen.schema.json",
  "title": "OpenXPC generation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["service", "clients"],
  "properties": {
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "generate"],
      "properties": {
        "target": { "$ref": "#/$defs/name" },
        "generate": { "const": "service" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    },
    "clients": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target", "generate", "operations"],
        "allOf": [
          { "anyOf": [
            { "properties": { "operations": { "minItems": 1 } } },
            { "required": ["subscriptions"], "properties": { "subscriptions": { "minItems": 1 } } }
          ] },
          { "if": { "properties": { "generate": { "const": "agentClient" } } },
            "then": { "properties": {
              "operations": { "minItems": 1 }, "subscriptions": { "maxItems": 0 }
            } }
          }
        ],
        "properties": {
          "target": { "$ref": "#/$defs/name" },
          "generate": { "enum": ["client", "agentClient"] },
          "operations": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/name" } },
          "subscriptions": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/name" } }
        }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$" }
  }
}
