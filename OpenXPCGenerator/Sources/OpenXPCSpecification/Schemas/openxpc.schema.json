{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openxpc.local/schemas/openxpc.schema.json",
  "title": "OpenXPC contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["service", "types", "operations"],
  "properties": {
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["identifier"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "maxPayloadBytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
      }
    },
    "types": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "fields"],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "fields": {
            "type": "array", "maxItems": 64,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "$ref": "#/$defs/name" },
                "type": { "$ref": "#/$defs/name" },
                "optional": { "type": "boolean" },
                "array": { "type": "boolean" },
                "maxLength": { "type": "integer", "minimum": 1, "maximum": 65536 },
                "maxBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
                "maxItems": { "type": "integer", "minimum": 1, "maximum": 128 },
                "injected": { "const": "projectRoot" }
              }
            }
          }
        }
      }
    },
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "request", "response"],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "request": { "$ref": "#/$defs/name" },
          "response": { "$ref": "#/$defs/name" },
          "tool": {
            "type": "object", "additionalProperties": false,
            "required": ["label", "description"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "parameters": { "type": "object" },
              "imageArtifact": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        }
      }
    },
    "subscriptions": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "request", "response", "event"],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "request": { "$ref": "#/$defs/name" },
          "response": { "$ref": "#/$defs/name" },
          "event": { "$ref": "#/$defs/name" }
        }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$" }
  }
}
